<!doctype html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ titulo }}</title>
<style>
:root{--brand:#1F4E78;--brand2:#2E75B6;--line:#e3e8ef}
body{font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;margin:0;background:#f7f9fc;color:#1a2330;line-height:1.55}
header{background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff;padding:28px}
header h1{margin:0 0 4px;font-size:23px}header p{margin:0;opacity:.9;font-size:13px}
main{max-width:1080px;margin:0 auto;padding:10px 26px 30px;background:#fff;border:1px solid var(--line);border-radius:12px;margin-top:18px}
h1{display:none}h2{color:var(--brand);border-bottom:2px solid var(--line);padding-bottom:6px;margin-top:26px}
table{border-collapse:collapse;width:100%;font-size:13px;margin:10px 0}
th,td{border:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top}th{background:var(--brand);color:#fff}
blockquote{background:#fff8e1;border-left:5px solid #b8860b;margin:10px 0;padding:8px 14px;border-radius:6px}
footer{max-width:1080px;margin:0 auto;padding:14px 26px;color:#5b6b7f;font-size:12px}
</style>
</head>
<body>
<header><h1 style="display:block">{{ titulo }}</h1><p>{{ subtitulo }}</p></header>
<main>
{{ corpo | safe }}
</main>
<footer>Versão executiva gerada pelo kit-rfp-observabilidade v{{ kit_versao }} em {{ gerado_em }}. Detalhe completo em <a href="{{ completo }}">{{ completo }}</a>.{% if confidencial %} Confidencial — uso restrito.{% endif %}</footer>
</body>
</html>
